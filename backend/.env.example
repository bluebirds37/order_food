# 复制为 .env 后按实际情况修改
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:15432/order_food
APP_PORT=8080
IMAGE_DIR=./data/images
PUBLIC_BASE_URL=http://localhost:8080

# 登录令牌有效期（小时）
TOKEN_TTL_HOURS=168

# 初始化超级管理员（仅首次启动创建，已存在则跳过）
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=请修改为强密码
SUPER_ADMIN_DISPLAY_NAME=超级管理员

# 初始化租户与租户管理员（仅首次启动创建）
INITIAL_TENANT_CODE=T001
INITIAL_TENANT_NAME=食光小馆
INITIAL_TENANT_STORE_NAME=食光小馆
INITIAL_TENANT_NOTICE=欢迎光临，现点现做
INITIAL_TENANT_INTRO=精选时令食材，现点现做，欢迎扫码点餐。
INITIAL_TENANT_ADMIN_USERNAME=tenantadmin
INITIAL_TENANT_ADMIN_PASSWORD=请修改为强密码
INITIAL_TENANT_ADMIN_DISPLAY_NAME=门店管理员
