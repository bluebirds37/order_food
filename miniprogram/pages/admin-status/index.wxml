<view class="page settings-page">
  <view class="page-head">
    <view class="page-title">店铺设置</view>
    <view class="page-sub">以下内容会同步展示在顾客点餐页</view>
  </view>

  <view class="card form-card">
    <view class="field">
      <text class="field-label">门店名称</text>
      <input class="input" value="{{status.storeName}}" data-field="storeName" bindinput="handleInput" placeholder="请输入门店名称" placeholder-class="input-ph" />
    </view>

    <view class="field">
      <text class="field-label">店铺介绍</text>
      <textarea class="textarea" value="{{status.intro}}" data-field="intro" bindinput="handleInput" placeholder="介绍门店特色、招牌菜等" placeholder-class="input-ph"></textarea>
      <text class="field-hint">展示在顾客菜单页顶部</text>
    </view>

    <view class="field">
      <text class="field-label">营业公告</text>
      <textarea class="textarea" value="{{status.notice}}" data-field="notice" bindinput="handleInput" placeholder="例如：今日招牌菜限量供应" placeholder-class="input-ph"></textarea>
    </view>

    <view class="switch-row">
      <view class="switch-copy">
        <view class="switch-title">营业状态</view>
        <view class="switch-desc">{{status.open ? '顾客可正常浏览菜单并下单' : '顾客可浏览菜单，暂不能下单'}}</view>
      </view>
      <switch checked="{{status.open}}" bindchange="handleSwitch" color="#b6532b" />
    </view>
  </view>

  <view class="settings-actions">
    <button class="primary-button btn-block" bindtap="saveStatus">保存设置</button>
    <button class="light-button btn-block" bindtap="backDashboard">返回工作台</button>
  </view>
</view>
