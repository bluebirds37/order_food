<view class="page auth-page">
  <view class="auth-head">
    <view class="brand-mark small">点</view>
    <view class="auth-title">{{mode === 'login' ? '顾客登录' : '顾客注册'}}</view>
    <view class="auth-sub">{{tenantName || '当前门店'}} · 登录后可下单并查看自己的订单</view>
  </view>

  <view class="card auth-card">
    <view class="field">
      <text class="field-label">手机号</text>
      <input class="input" value="{{phone}}" data-field="phone" bindinput="handleInput" placeholder="请输入手机号" type="number" placeholder-class="input-ph" />
    </view>
    <view wx:if="{{mode === 'register'}}" class="field">
      <text class="field-label">昵称</text>
      <input class="input" value="{{nickname}}" data-field="nickname" bindinput="handleInput" placeholder="选填，方便门店称呼" placeholder-class="input-ph" />
    </view>
    <view class="field">
      <text class="field-label">密码</text>
      <input class="input" value="{{password}}" data-field="password" bindinput="handleInput" placeholder="请输入密码（至少 6 位）" password placeholder-class="input-ph" />
    </view>

    <button class="primary-button btn-block auth-submit" loading="{{loading}}" bindtap="submit">{{mode === 'login' ? '登录' : '注册并登录'}}</button>
    <button class="text-link" bindtap="switchMode">{{mode === 'login' ? '没有账号？去注册' : '已有账号？去登录'}}</button>
  </view>
</view>
