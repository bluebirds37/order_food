.auth-page {
  justify-content: center;
  gap: var(--sp-5);
}

.auth-head {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0 var(--sp-1);
  gap: var(--sp-2);
}

.auth-title {
  font-size: var(--fs-display);
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--ink-900);
}

.auth-sub {
  color: var(--ink-500);
  font-size: var(--fs-sm);
  line-height: 1.7;
}

.auth-card {
  padding: var(--sp-5) var(--sp-4);
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
}

.auth-submit {
  margin-top: var(--sp-1);
}
