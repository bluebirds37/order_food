.page { padding: 24rpx 24rpx 180rpx; }
.hero { padding: 28rpx; display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.store-name { font-size: 42rpx; font-weight: 700; }
.notice { margin-top: 12rpx; color: #7f624f; }
.desk { margin-top: 8rpx; color: #a15b3d; }
.status-text { margin-top: 8rpx; color: #6a5748; font-size: 24rpx; }
.history-button { border-radius: 999rpx; background: #fff0e6; color: #9f4d2a; }
.customer-card { padding: 24rpx; margin-bottom: 20rpx; }
.input { height: 84rpx; background: #fff; border-radius: 20rpx; padding: 0 24rpx; margin-bottom: 16rpx; }
.menu-list { display: flex; flex-direction: column; gap: 18rpx; }
.dish-card { padding: 18rpx; display: flex; gap: 18rpx; }
.dish-image { width: 180rpx; height: 180rpx; border-radius: 22rpx; }
.dish-content { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.dish-top { display: flex; justify-content: space-between; font-size: 30rpx; font-weight: 600; }
.dish-desc { color: #7f624f; font-size: 24rpx; line-height: 1.7; margin: 12rpx 0; }
.add-button { margin: 0; }
.submit-bar { position: fixed; left: 24rpx; right: 24rpx; bottom: 24rpx; padding: 22rpx 26rpx; display: flex; justify-content: space-between; align-items: center; }
.cart-count { font-size: 24rpx; color: #7f624f; }
.cart-total { margin-top: 8rpx; font-size: 34rpx; font-weight: 700; }
.submit-button { margin: 0; padding: 0 36rpx; }
