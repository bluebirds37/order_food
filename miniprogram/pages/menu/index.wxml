<view class="page">
  <view class="hero card">
    <view>
      <view class="store-name">{{businessStatus.storeName}}</view>
      <view class="notice">{{businessStatus.notice}}</view>
      <view class="desk">当前桌号：{{deskCode}}</view>
      <view class="status-text">{{businessStatus.open ? '正在营业，可直接下单' : '门店暂未营业，请稍后再来'}}</view>
    </view>
    <button class="history-button" bindtap="goHistory">历史订单</button>
  </view>

  <view class="card customer-card">
    <input class="input" placeholder="请输入用餐人姓名" data-field="customerName" bindinput="handleInput" />
    <input class="input" placeholder="请输入联系电话" type="number" data-field="customerPhone" bindinput="handleInput" />
  </view>

  <view class="menu-list">
    <view class="card dish-card" wx:for="{{menuItems}}" wx:key="id">
      <image class="dish-image" src="{{item.imageUrl}}" mode="aspectFill" />
      <view class="dish-content">
        <view class="dish-top">
          <text class="dish-name">{{item.name}}</text>
          <text class="dish-price">¥{{item.price}}</text>
        </view>
        <view class="dish-desc">{{item.description}}</view>
        <button class="primary-button add-button" data-id="{{item.id}}" bindtap="addToCart">加入点单</button>
      </view>
    </view>
  </view>

  <view class="submit-bar card">
    <view>
      <view class="cart-count">已选 {{cartTypeCount}} 种菜品</view>
      <view class="cart-total">合计：¥{{cartTotal}}</view>
    </view>
    <button class="primary-button submit-button" bindtap="submitOrder">提交订单</button>
  </view>
</view>
