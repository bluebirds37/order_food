<view class="page">
  <view class="card history-card" wx:for="{{orders}}" wx:key="id">
    <view class="row"><text>订单号</text><text>{{item.orderNo}}</text></view>
    <view class="row"><text>状态</text><text>{{item.status}}</text></view>
    <view class="row"><text>金额</text><text>¥{{item.totalAmount}}</text></view>
    <view class="row"><text>时间</text><text>{{item.createdTime}}</text></view>
  </view>
</view>
