.detail-page {
  gap: var(--sp-4);
}

.receipt-hero {
  padding: var(--sp-5) var(--sp-4) var(--sp-4);
}

.receipt-eyebrow {
  color: var(--brand-100);
  font-size: var(--fs-xs);
  font-weight: 600;
  letter-spacing: 4rpx;
}

.receipt-no {
  margin-top: var(--sp-2);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.3;
  word-break: break-all;
}

.status-row {
  margin-top: var(--sp-2);
}

.receipt-hero .status-chip {
  background: var(--on-dark-line);
  color: var(--cream);
}

.receipt-meta {
  margin-top: var(--sp-4);
  padding-top: var(--sp-3);
  border-top: 1rpx solid var(--on-dark-line);
  display: flex;
  gap: var(--sp-6);
}

.receipt-meta-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.receipt-label {
  color: var(--cream-muted);
  font-size: var(--fs-xs);
}

.receipt-value {
  color: var(--cream);
  font-size: var(--fs-sm);
  font-weight: 600;
}

.item-card {
  padding: var(--sp-4);
}

.item-list {
  display: flex;
  flex-direction: column;
}

.item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--line);
}

.item:last-child {
  border-bottom: none;
}

.item-main {
  display: flex;
  align-items: baseline;
  gap: var(--sp-2);
  min-width: 0;
}

.item-name {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink-900);
}

.item-qty {
  color: var(--ink-400);
  font-size: var(--fs-xs);
}

.item-price {
  flex-shrink: 0;
  color: var(--ink-700);
  font-size: var(--fs-sm);
  font-weight: 600;
}

.total-row {
  margin-top: var(--sp-2);
  padding-top: var(--sp-3);
  border-top: 1rpx solid var(--line);
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.total-label {
  color: var(--ink-500);
  font-size: var(--fs-sm);
}

.total-amount {
  color: var(--brand-700);
  font-size: var(--fs-h2);
  font-weight: 700;
}

.detail-foot {
  margin-top: var(--sp-3);
  text-align: center;
  color: var(--ink-400);
  font-size: var(--fs-xs);
  line-height: 1.7;
}

.append-tip-card {
  margin-top: var(--sp-3);
  border: none;
  background: var(--brand-50);
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-3);
}

.append-icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--brand-600);
  color: var(--cream);
  font-size: var(--fs-h2);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding-bottom: 6rpx;
}

.append-tip-copy {
  flex: 1;
  min-width: 0;
}

.append-title {
  color: var(--ink-900);
  font-size: var(--fs-body);
  font-weight: 700;
  line-height: 1.3;
}

.append-desc {
  margin-top: 4rpx;
  color: var(--ink-500);
  font-size: var(--fs-xs);
  line-height: 1.5;
}

.append-tip-card .append-button {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 30rpx;
  margin: 0;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: var(--brand-600);
  color: var(--cream);
  font-size: var(--fs-sm);
  font-weight: 600;
  box-shadow: var(--shadow-brand);
}

.item-spec {
  margin-top: 6rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.item-spec-text {
  color: var(--ink-400);
  font-size: var(--fs-xs);
  line-height: 1.5;
}

.pickup-box {
  margin-top: var(--sp-3);
  padding: var(--sp-3);
  border-radius: var(--r-md);
  background: var(--on-dark-fill-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.pickup-label {
  color: var(--brand-100);
  font-size: var(--fs-xs);
  letter-spacing: 4rpx;
}

.pickup-no {
  color: var(--cream);
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: 8rpx;
}

.pickup-order {
  margin-top: 4rpx;
  color: var(--cream-muted);
  font-size: var(--fs-xs);
}
