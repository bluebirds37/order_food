<view class="page detail-page" wx:if="{{order}}">
  <view class="brand-panel receipt-hero">
    <view class="receipt-eyebrow">订单详情</view>
    <view class="pickup-box">
      <view class="pickup-label">取餐号</view>
      <view class="pickup-no">{{pickupNo}}</view>
      <view class="pickup-order">单号 {{order.orderNo}} · 桌号 {{order.deskCode || '未绑定'}}</view>
    </view>
    <view class="status-row">
      <text class="status-chip">{{order.statusText}}</text>
    </view>
    <view class="receipt-meta">
      <view class="receipt-meta-item">
        <text class="receipt-label">桌号</text>
        <text class="receipt-value">{{order.deskCode}}</text>
      </view>
      <view class="receipt-meta-item">
        <text class="receipt-label">下单时间</text>
        <text class="receipt-value">{{order.createdTime}}</text>
      </view>
    </view>
  </view>

  <view class="card item-card">
    <view class="section-head">
      <view class="section-title">菜品明细</view>
      <view class="section-sub">{{order.items.length}} 项</view>
    </view>
    <view class="item-list">
      <view class="item" wx:for="{{order.items}}" wx:key="index">
        <view class="item-main">
          <text class="item-name">{{item.itemName}}</text>
          <text class="item-qty">x {{item.quantity}}</text>
        </view>
        <view wx:if="{{item.flavor || item.remark}}" class="item-spec">
          <text wx:if="{{item.flavor}}" class="item-spec-text">口味：{{item.flavor}}</text>
          <text wx:if="{{item.remark}}" class="item-spec-text">备注：{{item.remark}}</text>
        </view>
        <text class="item-price">¥{{item.price}}</text>
      </view>
    </view>
    <view class="total-row">
      <text class="total-label">合计</text>
      <text class="total-amount">¥{{order.totalAmount}}</text>
    </view>
  </view>

  <view wx:if="{{canAppend}}" class="append-tip-card card">
    <view class="append-icon">＋</view>
    <view class="append-tip-copy">
      <view class="append-title">本轮消费还在进行中</view>
      <view class="append-desc">出餐前都可以继续加菜，将并入同一单</view>
    </view>
    <button class="append-button" bindtap="goAppend">追加菜品</button>
  </view>

  <view class="detail-foot">请凭订单号取餐，或留意门店叫号。</view>
</view>
