<view class="page" wx:if="{{order}}">
  <view class="card order-card">
    <view class="title">订单号 {{order.orderNo}}</view>
    <view class="meta">状态：{{order.status}}</view>
    <view class="meta">桌号：{{order.deskCode}}</view>
    <view class="meta">下单时间：{{order.createdTime}}</view>
  </view>
  <view class="card item-card">
    <view class="item" wx:for="{{order.items}}" wx:key="menuItemId">
      <text>{{item.itemName}} x {{item.quantity}}</text>
      <text>¥{{item.price}}</text>
    </view>
    <view class="total">实付：¥{{order.totalAmount}}</view>
  </view>
</view>
