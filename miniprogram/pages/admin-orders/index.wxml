<view class="page orders-page">
  <view class="page-head">
    <view class="page-title">订单管理</view>
    <view class="page-sub">共 {{orders.length}} 笔订单 · 点击状态按钮更新履约进度</view>
  </view>

  <view wx:if="{{orders.length === 0}}" class="card empty-card">
    <view class="empty-title">当前暂无订单</view>
    <view class="empty-text">顾客下单后会实时出现在这里</view>
  </view>

  <view class="card order-card" wx:for="{{orders}}" wx:key="id">
    <view class="order-top">
      <view class="order-heading">
        <text class="order-no">{{item.orderNo}}</text>
        <text class="order-sub">{{item.customerName}} · 桌号 {{item.deskCode}}</text>
      </view>
      <text class="status-chip {{item.status === 'PAID' ? 'is-paid' : item.status === 'PREPARING' ? 'is-preparing' : item.status === 'COMPLETED' ? 'is-completed' : 'is-cancelled'}}">{{item.statusText}}</text>
    </view>

    <view class="order-info">
      <view class="info-item">
        <text class="meta-label">下单时间</text>
        <text class="info-value">{{item.createdTime}}</text>
      </view>
      <view class="info-item align-right">
        <text class="meta-label">订单金额</text>
        <text class="info-value amount">¥{{item.totalAmount}}</text>
      </view>
    </view>

    <view class="item-list">
      <view class="item-row" wx:for="{{item.items}}" wx:for-item="detail" wx:key="index">
        <text class="item-name">{{detail.itemName}} x {{detail.quantity}}</text>
        <text class="item-price">¥{{detail.price}}</text>
        <view wx:if="{{detail.flavor || detail.remark}}" class="item-spec-row">
          <text wx:if="{{detail.flavor}}" class="item-spec-text">口味：{{detail.flavor}}</text>
          <text wx:if="{{detail.remark}}" class="item-spec-text">备注：{{detail.remark}}</text>
        </view>
      </view>
    </view>

    <view class="button-row">
      <button class="light-button" data-id="{{item.id}}" data-status="PAID" bindtap="updateStatus">已支付</button>
      <button class="light-button" data-id="{{item.id}}" data-status="PREPARING" bindtap="updateStatus">制作中</button>
      <button class="light-button" data-id="{{item.id}}" data-status="COMPLETED" bindtap="confirmTurnover">翻台</button>
      <button class="warn-button" data-id="{{item.id}}" data-status="CANCELLED" bindtap="updateStatus">取消</button>
    </view>
  </view>
</view>
