.tenants-page {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.page-head {
  margin-top: var(--sp-3);
  padding: var(--sp-4) var(--sp-3);
}

.page-title {
  font-size: var(--fs-h2);
  font-weight: 700;
  color: var(--ink-900);
}

.page-sub {
  margin-top: var(--sp-1);
  color: var(--ink-500);
  font-size: var(--fs-xs);
}

.tenant-card {
  margin-top: var(--sp-3);
  padding: var(--sp-3);
}

.tenant-card.is-disabled {
  opacity: 0.55;
}

.tenant-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-2);
}

.tenant-copy {
  flex: 1;
  min-width: 0;
}

.tenant-name {
  font-size: var(--fs-h3);
  font-weight: 700;
  color: var(--ink-900);
}

.tenant-code {
  margin-top: 4rpx;
  color: var(--ink-400);
  font-size: var(--fs-xs);
}

.tenant-tags {
  display: flex;
  gap: var(--sp-1);
  flex-shrink: 0;
}

.tenant-tag {
  padding: 4rpx 14rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-xs);
  font-weight: 600;
}

.tenant-tag.is-open {
  background: var(--brand-50);
  color: var(--brand-700);
}

.tenant-tag.is-closed {
  background: var(--surface-alt);
  color: var(--ink-400);
}

.tenant-tag.is-off {
  background: rgba(220, 38, 38, 0.08);
  color: #dc2626;
}

.tenant-stats {
  margin-top: var(--sp-3);
  padding: var(--sp-2) 0;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
  display: flex;
  justify-content: space-around;
}

.tenant-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.stat-num {
  font-size: var(--fs-h3);
  font-weight: 700;
  color: var(--ink-900);
  line-height: 1.2;
}

.stat-label {
  color: var(--ink-400);
  font-size: var(--fs-xs);
}

.tenant-enter {
  margin-top: var(--sp-3);
  width: 100%;
  height: 72rpx;
  padding: 0;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sm);
}
