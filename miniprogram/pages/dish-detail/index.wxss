.dish-detail-page {
  padding-bottom: calc(var(--sp-5) + env(safe-area-inset-bottom) + 140rpx);
}

.detail-swiper-wrap {
  margin: var(--sp-3) var(--sp-3) 0;
  border-radius: var(--r-xl);
  overflow: hidden;
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-float);
  background: var(--surface);
}

.detail-swiper {
  width: 100%;
  height: 560rpx;
}

.detail-banner {
  width: 100%;
  height: 560rpx;
  display: block;
}

.detail-banner.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-300);
  font-size: var(--fs-body);
  background: var(--surface-alt);
}

.detail-body {
  margin: var(--sp-3) var(--sp-3) 0;
  padding: var(--sp-4);
}

.detail-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-3);
}

.detail-name-block {
  min-width: 0;
  flex: 1;
}

.detail-name {
  font-size: var(--fs-h2);
  font-weight: 700;
  color: var(--ink-900);
  line-height: 1.3;
}

.detail-category {
  margin-top: var(--sp-1);
  color: var(--ink-400);
  font-size: var(--fs-xs);
}

.detail-price {
  flex-shrink: 0;
  color: var(--brand-600);
  font-size: var(--fs-h2);
  font-weight: 700;
  line-height: 1.2;
}

.detail-price .price-symbol {
  font-size: var(--fs-body);
  font-weight: 600;
}

.detail-section-title {
  margin-top: var(--sp-4);
  padding-top: var(--sp-3);
  border-top: 1rpx solid var(--line);
  color: var(--ink-700);
  font-size: var(--fs-sm);
  font-weight: 700;
}

.detail-text {
  margin-top: var(--sp-2);
  color: var(--ink-500);
  font-size: var(--fs-body);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

.detail-actions {
  position: fixed;
  left: var(--sp-3);
  right: var(--sp-3);
  bottom: calc(var(--sp-3) + env(safe-area-inset-bottom));
  z-index: 20;
}

.detail-add-button {
  width: 100%;
  height: 88rpx;
  padding: 0;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
}
