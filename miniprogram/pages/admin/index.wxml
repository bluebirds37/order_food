<view class="page dashboard-page">
  <view class="brand-panel dash-hero">
    <view class="dash-top">
      <view class="dash-heading">
        <view class="dash-eyebrow">{{role === 'SUPER_ADMIN' ? '超级管理员' : '门店管理员'}}</view>
        <view class="dash-title">{{dashboard.storeName || tenantName}}</view>
        <view class="dash-sub">{{tenantCode}} · {{adminName}}</view>
      </view>
      <button class="hero-text-button" bindtap="logout">退出</button>
    </view>
    <view class="dash-status">
      <view class="open-pill {{dashboard.open ? 'is-open' : 'is-closed'}}">
        <view class="open-dot"></view>
        <text>{{dashboard.open ? '营业中' : '已打烊'}}</text>
      </view>
      <text class="dash-notice">{{dashboard.notice || '暂无门店公告'}}</text>
    </view>
  </view>

  <view class="stat-grid">
    <view class="card stat-card stat-accent">
      <text class="stat-label stat-label-light">今日营收</text>
      <text class="stat-value stat-value-light">¥{{dashboard.todayRevenue}}</text>
      <text class="stat-hint">已支付订单实时汇总</text>
    </view>
    <view class="card stat-card">
      <text class="stat-label">今日订单</text>
      <view class="stat-line">
        <text class="stat-value">{{dashboard.todayOrderCount}}</text>
        <text class="stat-unit">单</text>
      </view>
    </view>
    <view class="card stat-card">
      <text class="stat-label">在售菜品</text>
      <view class="stat-line">
        <text class="stat-value">{{dashboard.availableMenuCount}}</text>
        <text class="stat-unit">道</text>
      </view>
    </view>
  </view>

  <view class="card nav-card">
    <view class="section-head">
      <view class="section-title">门店管理</view>
      <view class="section-sub">常用操作</view>
    </view>
    <view class="nav-list">
      <view wx:if="{{role === 'SUPER_ADMIN'}}" class="nav-item" data-url="/pages/admin-tenants/index" bindtap="navigateToPage">
        <view class="nav-icon">切</view>
        <view class="nav-copy">
          <view class="nav-title">切换门店</view>
          <view class="nav-desc">选择其他门店并管理其全部内容</view>
        </view>
        <text class="nav-arrow">›</text>
      </view>
      <view class="nav-item" data-url="/pages/admin-status/index" bindtap="navigateToPage">
        <view class="nav-icon">店</view>
        <view class="nav-copy">
          <view class="nav-title">营业状态与介绍</view>
          <view class="nav-desc">调整营业开关、店铺介绍与门店公告</view>
        </view>
        <text class="nav-arrow">›</text>
      </view>
      <view class="nav-item" data-url="/pages/admin-menu/index" bindtap="navigateToPage">
        <view class="nav-icon">菜</view>
        <view class="nav-copy">
          <view class="nav-title">菜单管理</view>
          <view class="nav-desc">菜品、价格、上下架、分类与图片</view>
        </view>
        <text class="nav-arrow">›</text>
      </view>
      <view class="nav-item" data-url="/pages/admin-kitchen/index" bindtap="navigateToPage">
        <view class="nav-icon">排</view>
        <view class="nav-copy">
          <view class="nav-title">排餐看板</view>
          <view class="nav-desc">按桌排餐出餐，同桌相同口味自动合并</view>
        </view>
        <text class="nav-arrow">›</text>
      </view>
      <view class="nav-item" data-url="/pages/admin-desks/index" bindtap="navigateToPage">
        <view class="nav-icon">桌</view>
        <view class="nav-copy">
          <view class="nav-title">桌号管理</view>
          <view class="nav-desc">维护门店桌号，供顾客点餐时选择</view>
        </view>
        <text class="nav-arrow">›</text>
      </view>
      <view class="nav-item" data-url="/pages/admin-orders/index" bindtap="navigateToPage">
        <view class="nav-icon">单</view>
        <view class="nav-copy">
          <view class="nav-title">订单管理</view>
          <view class="nav-desc">查看订单并更新履约状态</view>
        </view>
        <text class="nav-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card latest-card">
    <view class="section-head">
      <view class="section-title">最新订单</view>
      <view class="section-sub">实时</view>
    </view>
    <view wx:if="{{dashboard.latestOrders.length === 0}}" class="empty-state">当前暂无订单</view>
    <view wx:for="{{dashboard.latestOrders}}" wx:key="id" class="latest-item">
      <view class="latest-left">
        <text class="latest-no">{{item.orderNo}}</text>
        <text class="latest-sub">{{item.customerName}} · {{item.deskCode}}</text>
      </view>
      <view class="latest-right">
        <text class="latest-amount">¥{{item.totalAmount}}</text>
        <text class="status-chip {{item.status === 'PAID' ? 'is-paid' : item.status === 'PREPARING' ? 'is-preparing' : item.status === 'COMPLETED' ? 'is-completed' : 'is-cancelled'}}">{{item.statusText}}</text>
      </view>
    </view>
  </view>
</view>
