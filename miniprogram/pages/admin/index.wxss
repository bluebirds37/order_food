.dashboard-page {
  gap: var(--sp-4);
}

.dash-hero {
  padding: var(--sp-5) var(--sp-4) var(--sp-4);
}

.dash-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--sp-3);
}

.dash-heading {
  flex: 1;
  min-width: 0;
}

.dash-eyebrow {
  color: var(--brand-100);
  font-size: var(--fs-xs);
  font-weight: 600;
  letter-spacing: 4rpx;
}

.dash-title {
  margin-top: var(--sp-1);
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.dash-sub {
  margin-top: var(--sp-1);
  color: var(--cream-muted);
  font-size: var(--fs-sm);
}

.dash-hero .hero-text-button {
  width: 96rpx;
  flex-shrink: 0;
  height: 60rpx;
  padding: 0 var(--sp-2);
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-pill);
  border: 1rpx solid var(--on-dark-line-strong);
  background: var(--on-dark-fill);
  color: var(--cream);
  font-size: var(--fs-xs);
  font-weight: 600;
}

.dash-status {
  margin-top: var(--sp-4);
  padding-top: var(--sp-3);
  border-top: 1rpx solid var(--on-dark-line);
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.open-pill {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  flex-shrink: 0;
  height: 48rpx;
  padding: 0 var(--sp-2);
  border-radius: var(--r-pill);
  background: var(--on-dark-fill-strong);
  color: var(--cream);
  font-size: var(--fs-xs);
  font-weight: 600;
}

.open-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--cream-muted);
}

.open-pill.is-open .open-dot {
  background: var(--open-dot-color);
  box-shadow: 0 0 0 6rpx var(--open-dot-glow);
}

.open-pill.is-closed .open-dot {
  background: var(--closed-dot-color);
}

.dash-notice {
  flex: 1;
  min-width: 0;
  color: var(--cream-muted);
  font-size: var(--fs-xs);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--sp-2);
}

.stat-card {
  padding: var(--sp-3);
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
  min-width: 0;
}

.stat-accent {
  grid-column: 1 / -1;
  background: linear-gradient(135deg, var(--brand-600) 0%, var(--brand-800) 100%);
  border-color: transparent;
  box-shadow: var(--shadow-brand-lg);
}

.stat-label {
  color: var(--ink-500);
  font-size: var(--fs-xs);
}

.stat-label-light {
  color: var(--brand-100);
}

.stat-value {
  font-size: var(--fs-h1);
  font-weight: 700;
  line-height: 1.15;
  color: var(--ink-900);
}

.stat-value-light {
  color: var(--cream);
}

.stat-hint {
  color: var(--on-dark-text);
  font-size: var(--fs-xs);
}

.stat-line {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.stat-unit {
  color: var(--ink-400);
  font-size: var(--fs-xs);
}

.nav-card,
.latest-card {
  padding: var(--sp-4);
}

.nav-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.nav-item {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-3);
  border-radius: var(--r-md);
  background: var(--surface-alt);
  border: 1rpx solid var(--line);
}

.nav-icon {
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  color: var(--brand-700);
  font-size: var(--fs-h3);
  font-weight: 700;
}

.nav-copy {
  flex: 1;
  min-width: 0;
}

.nav-title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink-900);
}

.nav-desc {
  margin-top: 4rpx;
  font-size: var(--fs-xs);
  color: var(--ink-500);
  line-height: 1.5;
}

.nav-arrow {
  flex-shrink: 0;
  color: var(--brand-600);
  font-size: var(--fs-h3);
  font-weight: 600;
}

.latest-item {
  padding: var(--sp-3) 0;
  border-bottom: 1rpx solid var(--line);
}

.latest-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.latest-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.latest-no {
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--ink-900);
  word-break: break-all;
}

.latest-sub {
  color: var(--ink-400);
  font-size: var(--fs-xs);
}

.latest-right {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: var(--sp-2);
}

.latest-amount {
  color: var(--brand-700);
  font-size: var(--fs-body);
  font-weight: 700;
}
