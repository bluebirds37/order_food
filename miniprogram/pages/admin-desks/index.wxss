.desks-page {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.section-card {
  padding: var(--sp-4);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-3);
}

.section-head .section-title {
  flex: 1;
  min-width: 0;
}

.section-card .add-button {
  flex-shrink: 0;
  width: auto;
  height: 68rpx;
  padding: 0 var(--sp-3);
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sm);
}

.section-sub {
  margin-top: var(--sp-1);
  color: var(--ink-400);
  font-size: var(--fs-xs);
}

.desk-grid {
  margin-top: var(--sp-4);
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-3);
}

.desk-card {
  width: calc((100% - 2 * var(--sp-3)) / 3);
  border-radius: var(--r-md);
  border: 1rpx solid var(--line);
  background: var(--surface-alt);
  padding: var(--sp-3) var(--sp-2) var(--sp-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--sp-2);
  box-sizing: border-box;
}

.desk-code {
  font-size: var(--fs-h2);
  font-weight: 700;
  color: var(--ink-900);
  line-height: 1.2;
}

.desk-actions {
  width: 100%;
  display: flex;
  gap: 12rpx;
}

.desk-action {
  flex: 1;
  height: 52rpx;
  border-radius: 26rpx;
  font-size: var(--fs-xs);
  line-height: 1;
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-50);
  color: var(--brand-700);
}

.desk-action.is-danger {
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--ink-400);
}
